{
  "buildCommand": null,
  "outputDirectory": "dist",
  "installCommand": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!_expo|assets).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(assets|_expo/static)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
